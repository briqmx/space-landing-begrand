---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
---

<Layout noindex title="Página no encontrada | Sumametros®">
  <Nav />
  <section class="py-24">
    <div class="container flex flex-col items-center gap-6 text-center">
      <h1 class="text-2xl md:text-4xl font-bold">No encontramos esta página</h1>
      <p>El enlace puede estar roto o la página ya no existe.</p>
      <div class="flex items-center gap-4 flex-wrap justify-center">
        <a class="button" href="/">Ir al inicio</a>
        <a class="underline" href="/calculadora/">Calculadora</a>
      </div>
    </div>
  </section>
</Layout>
